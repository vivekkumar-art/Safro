# ==============================================================================
# SAFRO Environment Configuration
# ==============================================================================

# Client-Side Supabase Configuration (Vite Public)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Google Maps API Configuration (Vite Public)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ==============================================================================
# Administrative Credentials & Security (BACKEND ONLY — NEVER EXPOSE TO CLIENT)
# DO NOT PREFIX WITH VITE_
# ==============================================================================
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_SESSION_SECRET=safro_admin_session_secret_minimum_32_characters_random_string

# Optional Email Delivery for Password Reset (Leave blank if unconfigured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@safro.travel

# Optional Google OAuth for Administrator SSO (Leave blank if unconfigured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
